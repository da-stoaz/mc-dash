NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Optional. The dashboard normally reads the router domain from the backend at
# runtime (GET /config, sourced from MC_ROUTER_DOMAIN), so you only need this as
# a fallback for when the backend is unreachable. Note it is baked into the
# bundle at build time, so changing it requires a rebuild.
# NEXT_PUBLIC_ROUTER_DOMAIN=mc.example.com
