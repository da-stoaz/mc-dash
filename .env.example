# Copy to .env and adjust. Used by docker-compose.yml.
#
# Replace 192.168.1.50 with your Linux host's LAN IP (run `hostname -I`).
# The browser must be able to reach the backend at this address, so it CANNOT
# be localhost when you open the dashboard from another machine.

# --- URLs (browser-facing) ---
NEXT_PUBLIC_API_BASE_URL=http://192.168.1.50:4000
MC_DASH_FRONTEND_ORIGIN=http://192.168.1.50:3000

# --- Data ---
# Absolute path on the host where SQLite + server packs live. Created on first
# run. Must be absolute (the backend mounts it into MC containers by this path).
MC_DASH_DATA_DIR=/opt/mc-dash/data
# User the spawned Minecraft containers run as. Leave empty to match the backend
# (root under compose), which keeps server files readable for snapshots. Set to
# a uid:gid (e.g. 1000:1000) to run servers un-privileged instead.
# MC_CONTAINER_USER=

# --- Auth ---
# Required: the backend refuses to start without it (min 12 chars, no
# placeholders). Generate both of these, e.g.
#   openssl rand -base64 24   # password
#   openssl rand -hex 32      # session secret
MC_DASH_PASSWORD=
MC_DASH_SESSION_SECRET=replace-with-openssl-rand-hex-32
# Escape hatch to run with NO login at all. Trusted LAN / local dev only.
# MC_DASH_ALLOW_NO_AUTH=false
# Keep false for plain HTTP on a LAN (true would drop the cookie over http).
# Set true whenever the dashboard is served over HTTPS (e.g. behind a tunnel).
MC_DASH_COOKIE_SECURE=false

# --- Reverse proxy / tunnel (see "Exposing it to the internet" in DEPLOY.md) ---
# Bind the API to loopback so the port can't be reached around the proxy.
# MC_DASH_BIND_HOST=127.0.0.1
# Read the client IP from X-Forwarded-For. Only set this when the port is NOT
# directly reachable, or clients can forge their IP past the login throttle.
# MC_DASH_TRUST_PROXY=loopback

# --- Server ports ---
MC_SERVER_PORT_MIN=25565
MC_SERVER_PORT_MAX=25665

# --- Optional wildcard-subdomain router ---
MC_ROUTER_ENABLED=false
MC_ROUTER_DOMAIN=mc.example.com
MC_ROUTER_PORT=25565

# --- Uploads -----------------------------------------------------------------
# Server packs and snapshot archives are uploaded in slices rather than as one
# request, because the proxy in front usually caps request bodies — Cloudflare
# Tunnel refuses anything over 100 MB on its cheaper plans, and rejects on
# Content-Length before reading a byte, so a single-request upload parks at 1%
# with no error to show. Chunking keeps every request far below any such ceiling.

# Backstop against an absurd declared size, not the real limit. Snapshots carry
# a whole world and reach tens of gigabytes, so this is deliberately loose — what
# actually protects the host is the free-space check below.
# MC_DASH_MAX_UPLOAD_MB=32768
# Refuse an upload that would leave the disk with less than this free, so the
# extracted world, the logs and the running servers still have room afterwards.
# Checked up front, against the declared size, before any bytes move.
# MC_DASH_UPLOAD_DISK_MARGIN_MB=2048
# Smallest slice a request carries. Lower it only if something in front of MC
# Dash caps bodies below 8 MB, which is unusual.
# MC_DASH_UPLOAD_CHUNK_MB=8
# Slices are sent one after another, so a fixed small slice makes a multi-GB
# upload thousands of sequential round trips. They grow with the file instead,
# aiming for ~200 requests whatever its size, up to this ceiling. Keep it under
# the body limit of whatever proxies you (100 MB on Cloudflare Free/Pro).
# MC_DASH_UPLOAD_CHUNK_MAX_MB=64
