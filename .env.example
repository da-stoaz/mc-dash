# Copy to .env and adjust. Used by docker-compose.yml.
#
# Replace 192.168.1.50 with your Linux host's LAN IP (run `hostname -I`).
# The browser must be able to reach the backend at this address, so it CANNOT
# be localhost when you open the dashboard from another machine.

# --- URLs (browser-facing) ---
NEXT_PUBLIC_API_BASE_URL=http://192.168.1.50:4000
MC_DASH_FRONTEND_ORIGIN=http://192.168.1.50:3000

# --- Data ---
# Absolute path on the host where SQLite + server packs live. Created on first
# run. Must be absolute (the backend mounts it into MC containers by this path).
MC_DASH_DATA_DIR=/opt/mc-dash/data
# User the spawned Minecraft containers run as. Leave empty to match the backend
# (root under compose), which keeps server files readable for snapshots. Set to
# a uid:gid (e.g. 1000:1000) to run servers un-privileged instead.
# MC_CONTAINER_USER=
# Optional: enables automatic lookup/download of CurseForge-only dependencies.
# Modrinth and the verified NightLib 1.20.1 Forge fallback work without a key.
# CURSEFORGE_API_KEY=

# --- Auth ---
# Required: the backend refuses to start without it (min 12 chars, no
# placeholders). Generate both of these, e.g.
#   openssl rand -base64 24   # password
#   openssl rand -hex 32      # session secret
MC_DASH_PASSWORD=
MC_DASH_SESSION_SECRET=replace-with-openssl-rand-hex-32
# Escape hatch to run with NO login at all. Trusted LAN / local dev only.
# MC_DASH_ALLOW_NO_AUTH=false
# Keep false for plain HTTP on a LAN (true would drop the cookie over http).
# Set true whenever the dashboard is served over HTTPS (e.g. behind a tunnel).
MC_DASH_COOKIE_SECURE=false

# --- Reverse proxy / tunnel (see "Exposing it to the internet" in DEPLOY.md) ---
# Bind the API to loopback so the port can't be reached around the proxy.
# MC_DASH_BIND_HOST=127.0.0.1
# Read the client IP from X-Forwarded-For. Only set this when the port is NOT
# directly reachable, or clients can forge their IP past the login throttle.
# MC_DASH_TRUST_PROXY=loopback

# --- Server ports ---
MC_SERVER_PORT_MIN=25565
MC_SERVER_PORT_MAX=25665

# --- Optional wildcard-subdomain router ---
MC_ROUTER_ENABLED=false
MC_ROUTER_DOMAIN=mc.example.com
MC_ROUTER_PORT=25565

# --- Memory management -------------------------------------------------------
# Minecraft containers share the installed minecraft.slice MemoryMax (12G in
# deploy/systemd/minecraft.slice). The backend reads that OS limit directly.
# Keep MC Dash backend/frontend OUTSIDE the Minecraft pool. See docs/memory-pool.md.
# Linux enforcement is a draft pending runtime/overload validation.
# Set false for local development without that host configuration (monitor only).
MC_DASH_MEMORY_POOL=true
# Additional host free-memory check before Minecraft starts:
# MC_DASH_HOST_FREE_FLOOR_MB=512

# A JVM needs memory outside its heap (metaspace, code cache, thread stacks, GC
# structures), and all of it counts against the container limit. The limit
# includes an allowance above max heap RAM for this overhead.
# MC_DASH_JVM_OVERHEAD_PERCENT=15
# MC_DASH_JVM_OVERHEAD_MIN_MB=256

# Per-container swap policy (the production shared pool always prohibits swap):
#   off   - they cannot swap at all. A server that exceeds its limit is killed
#           by the kernel instead of dragging the host into swap thrash.
#   limit - swap allowed up to the limit again, but only under real pressure.
#   host  - inherit the Docker daemon default.
# MC_DASH_CONTAINER_SWAP=off

# Elastic heap: rewrite each pack's JVM flags so an idle server hands committed
# heap back to the OS. The amount reclaimed depends on the live objects and
# the JVM; this does not fix a leak. Needs Java 12+ for periodic G1 collection;
# older JVMs ignore flags they do not recognize.
# MC_DASH_ELASTIC_HEAP=true
# How long a server must go without a garbage collection before the JVM runs a
# reclaiming one. A quiet GC interval does not prove that no players are active.
# MC_DASH_ELASTIC_HEAP_IDLE_SECONDS=300

# --- Hibernation -------------------------------------------------------------
# Elastic heap makes an idle server smaller; hibernation makes it free. A server
# with nobody on it is stopped outright, releasing 100% of its memory and CPU,
# and started again when a player connects. Off by default because it trades a
# cold start (~30-90s for a modpack) for that memory.
# MC_DASH_HIBERNATE=false

# Continuous stretch with zero players before a server sleeps. Player counts come
# from RCON only — a count MC Dash can't read resets the clock instead of
# counting as empty, so a server it cannot ask is never one it puts to sleep.
# MC_DASH_HIBERNATE_IDLE_MINUTES=5

# Hold the sleeping server's port so a join can wake it. With this off, a
# hibernated server can only be started from the dashboard — fine for a private
# server, a bad surprise for a public one.
# MC_DASH_HIBERNATE_WAKE_ON_CONNECT=true

# What players see: the MOTD in their server list while it sleeps, and the
# disconnect message after a join has triggered the start. The first join after a
# sleep always costs one bounced connection — a Minecraft client times out long
# before a modpack finishes booting, so telling the player to reconnect is the
# only honest option.
# MC_DASH_HIBERNATE_MOTD=Sleeping — join to wake this server up
# MC_DASH_HIBERNATE_WAKE_MESSAGE=This server was asleep and is starting now.

# --- Uploads -----------------------------------------------------------------
# Server packs and snapshot archives are uploaded in slices rather than as one
# request, because the proxy in front usually caps request bodies — Cloudflare
# Tunnel refuses anything over 100 MB on its cheaper plans, and rejects on
# Content-Length before reading a byte, so a single-request upload parks at 1%
# with no error to show. Chunking keeps every request far below any such ceiling.

# Backstop against an absurd declared size, not the real limit. Snapshots carry
# a whole world and reach tens of gigabytes, so this is deliberately loose — what
# actually protects the host is the free-space check below.
# MC_DASH_MAX_UPLOAD_MB=32768
# An upload needs room for more than itself: the archive is staged whole, then
# extracted alongside it. Require this multiple of the declared size to be free
# before accepting one — checked up front, before any bytes move. Raise it if
# your worlds compress well, since a snapshot that halves in size needs more
# than 1.5x on the way back out.
# MC_DASH_UPLOAD_DISK_FACTOR=1.5
# Floor for small uploads, where a multiple of the size reserves nothing useful.
# MC_DASH_UPLOAD_DISK_MIN_FREE_MB=2048
# Smallest slice a request carries. Lower it only if something in front of MC
# Dash caps bodies below 8 MB, which is unusual.
# MC_DASH_UPLOAD_CHUNK_MB=8
# Slices are sent one after another, so a fixed small slice makes a multi-GB
# upload thousands of sequential round trips. They grow with the file instead,
# aiming for ~200 requests whatever its size, up to this ceiling. Keep it under
# the body limit of whatever proxies you (100 MB on Cloudflare Free/Pro).
# MC_DASH_UPLOAD_CHUNK_MAX_MB=64
