{
  "name": "backend",
  "version": "1.0.0",
  "description": "Minecraft server manager API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json && cp src/services/serverFileWorker*.py src/services/zipExtractionWorker.cjs src/services/snapshotArchiveWorker.cjs dist/services/",
    "start": "node dist/index.js",
    "lint": "echo \"lint not configured\"",
    "test": "node -r ts-node/register --test \"src/**/*.test.ts\"",
    "test:jvm-integration": "node -r ts-node/register --test src/services/jvmMemoryInspection.integration.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^12.5.0",
    "cors": "^2.8.5",
    "dockerode": "^4.0.9",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "pino": "^10.1.0",
    "tar": "^7.5.16",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "dockerode": {
      "uuid": "^11.1.1"
    }
  }
}
