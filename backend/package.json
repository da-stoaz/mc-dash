{
  "name": "backend",
  "version": "1.1.0",
  "description": "Minecraft server manager API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json && cp src/services/serverFileWorker*.py src/services/zipExtractionWorker.cjs src/services/snapshotArchiveWorker.cjs dist/services/",
    "start": "node dist/index.js",
    "lint": "echo \"lint not configured\"",
    "test": "node -r ts-node/register --test \"src/**/*.test.ts\"",
    "test:jvm-integration": "node -r ts-node/register --test src/services/jvmMemoryInspection.integration.ts"
  },
  "keywords": [],
  "author": "da-stoaz",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/da-stoaz/mc-dash.git",
    "directory": "backend"
  },
  "homepage": "https://github.com/da-stoaz/mc-dash#readme",
  "bugs": {
    "url": "https://github.com/da-stoaz/mc-dash/issues"
  },
  "type": "commonjs",
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^13.2.0",
    "cors": "^2.8.6",
    "dockerode": "^5.0.1",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "multer": "^2.5.0",
    "pino": "^10.4.0",
    "tar": "^7.5.23",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
}
